      },
      {
        "name": "alpha",
        "role": "nuisance",
        "nominal": 0.0,
        "bounds": [
          -5.0,
          5.0
        ],
        "constraint": {
          "kind": "normal",
          "mean": 0.0,
          "sigma": 1.0
        }
      }
    ],
    "workspace": {
