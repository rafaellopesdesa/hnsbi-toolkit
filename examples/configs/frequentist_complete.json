{
  "schema_version": "1.0",
  "features": [
    "x1",
    "x2",
    "x3",
    "x4",
    "x5",
    "x6"
  ],
  "output_dir": "artifacts/frequentist",
  "frequentist": {
    "reference": {
      "kind": "parquet",
      "path": "data/reference.parquet",
      "weight_column": "weight",
      "event_id_column": "event_id",
      "batch_size": 65536
    },
    "samples": [
      {
        "name": "signal",
        "source": {
          "kind": "parquet",
          "path": "data/signal.parquet",
          "weight_column": "weight",
          "event_id_column": "event_id",
          "batch_size": 65536
        },
        "nominal_yield": 611.6,
        "multiplier": "mu"
      },
      {
        "name": "background",
        "source": {
          "kind": "parquet",
          "path": "data/background.parquet",
          "weight_column": "weight",
          "event_id_column": "event_id",
          "batch_size": 65536
        },
        "nominal_yield": 152822.48,
        "multiplier": "1"
      }
    ],
    "flow": {
      "architecture": "quadratic_spline",
      "n_coupling_layers": 10,
      "hidden_features": 1024,
      "hidden_layers": 4,
      "spline_num_bins": 16,
      "spline_tail_bound": 5.0,
      "dropout_probability": 0.0,
      "training": {
        "epochs": 70,
        "batch_size": 2048,
        "learning_rate": 0.0001,
        "validation_fraction": 0.2,
        "early_stopping_patience": 10,
        "lr_reduction_factor": 0.2,
        "seed": 20260726,
        "device": "auto"
      },
      "onnx_opset": 17
    },
    "ratios": {
      "backend": "nsbi_common_utils",
      "ensemble_size": 4,
      "training": {
        "epochs": 100,
        "batch_size": 4096,
        "learning_rate": 0.001,
        "hidden_layers": 3,
        "neurons": 256,
        "activation": "swish",
        "validation_fraction": 0.1,
        "holdout_fraction": 0.3,
        "early_stopping_patience": 30,
        "seed": 20260727
      },
      "normalization": "independent_reference_mean",
      "diagnostics": {
        "overtraining": true,
        "calibration": true,
        "reweighting": true,
        "normalization": true
      }
    },
    "parameters": [
      {
        "name": "mu",
        "role": "poi",
        "nominal": 1.0,
        "bounds": [
          0.0,
          5.0
