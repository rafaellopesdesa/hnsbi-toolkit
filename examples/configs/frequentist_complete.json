      "output_path": "artifacts/frequentist/workspace.json"
    },
    "systematics": [
      {
        "name": "shape_alpha",
        "parameter": "alpha",
        "type": "norm_plus_shape",
        "interpolation": "nsbi_code4p",
        "variations": [
          {
            "sample": "signal",
            "up": {
              "kind": "parquet",
              "path": "data/signal_alpha_up.parquet",
              "weight_column": "weight"
            },
            "down": {
              "kind": "parquet",
              "path": "data/signal_alpha_down.parquet",
              "weight_column": "weight"
            }
          },
          {
            "sample": "background",
            "up": {
              "kind": "parquet",
              "path": "data/background_alpha_up.parquet",
              "weight_column": "weight"
            },
            "down": {
              "kind": "parquet",
              "path": "data/background_alpha_down.parquet",
              "weight_column": "weight"
            }
          }
        ]
      }
    ],
    "toys": {
      "parameter_points": [
        {
          "mu": 0.0,
          "alpha": 0.0
        },
        {
          "mu": 1.0,
          "alpha": 0.0
        }
      ],
      "toys_per_point": 1000,
      "method": "importance_resampling",
      "proposal_events": 1000000,
      "output_path": "artifacts/frequentist/toys"
