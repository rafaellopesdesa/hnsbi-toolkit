        {
          "mu": 0.5,
          "alpha": 0.0
        },
        {
          "mu": 1.0,
          "alpha": 0.0
        },
        {
          "mu": 2.0,
          "alpha": 0.0
        }
      ],
      "epsilon": 0.1,
      "pilot_events": 200000,
      "target_events": 2048,
      "flow": {
        "architecture": "realnvp",
        "n_coupling_layers": 8,
        "hidden_features": 128,
        "hidden_layers": 2,
        "scale_clip": 1.5,
        "training": {
          "epochs": 100,
          "batch_size": 2048,
          "learning_rate": 0.0005,
          "validation_fraction": 0.2,
          "early_stopping_patience": 12,
          "seed": 20260728,
          "device": "auto"
        },
        "onnx_opset": 17
      },
      "output_path": "artifacts/frequentist/nis"
    }
  }
}
